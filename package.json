{
  "name": "contatos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --env-file=.env --watch server/index.js",
